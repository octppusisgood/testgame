[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.11, 0.12, 0.14, 1)
# 3D 渲染分辨率降到 67%（canvas_items 拉伸只缩 2D，3D 原本按 1920×1080 全量光栅化；
# bilinear 放大后观感几乎不变，填充率/蒙皮片段成本约省一半）
scaling_3d/mode=0
scaling_3d/scale=0.67
